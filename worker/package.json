{
  "name": "catchup-proxy",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create catchup-db",
    "db:migrate": "wrangler d1 execute catchup-db --remote --file=./schema.sql",
    "secret:anthropic": "wrangler secret put ANTHROPIC_API_KEY",
    "secret:proxy": "wrangler secret put PROXY_SHARED_SECRET",
    "secret:stripe": "wrangler secret put STRIPE_SECRET_KEY",
    "secret:stripe-webhook": "wrangler secret put STRIPE_WEBHOOK_SECRET"
  },
  "dependencies": {
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.90.0"
  }
}
