# Copy to .env.local and fill in. NEVER commit .env.local.
GOOGLE_CLIENT_ID=          # Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (type: Chrome Extension)
CATCHUP_PROXY_URL=         # e.g. https://catchup-proxy.<your-subdomain>.workers.dev/catchup
CATCHUP_PROXY_SECRET=      # any string you make up; must match the worker's PROXY_SHARED_SECRET
